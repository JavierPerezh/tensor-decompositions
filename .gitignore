# Entornos virtuales y caché de Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Datasets pesados y figuras exportadas (van a Overleaf, no a Git)
data/*
!data/.gitkeep
figures_export/*
!figures_export/.gitkeep

# Bloqueo absoluto de archivos LaTeX / Overleaf en GitHub
*.tex
*.bib
*.aux
*.log
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
data/*.npz
